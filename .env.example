# ==============================================================================
# نمونه فایل تنظیمات متغیرهای محیطی برای استقرار عملیاتی (Production)
# ==============================================================================
# توجه امنیتی: این فایل صرفاً نمونه است. مقادیر واقعی را در فایل .env قرار دهید.
# هرگز فایل .env، کلیدها و گذرواژه‌های واقعی را در گیت یا گزارش عمومی قرار ندهید.
# ==============================================================================

# محیط اجرا: production یا development (در استقرار حتماً production باشد)
DJANGO_ENV=production

# کلید مخفی و امن برنامه (حداقل ۵۰ کاراکتر تصادفی و غیرقابل حدس)
DJANGO_SECRET_KEY=change-me-to-a-secure-random-secret-key-with-at-least-50-characters

# حالت اشکال‌زدایی (در محیط عملیاتی حتماً 0 باشد)
DJANGO_DEBUG=0

# دامنه‌ها و آی‌پی‌های مجاز برای دسترسی به سامانه (با کاما جدا شوند)
# آی‌پی 127.0.0.1 و localhost به صورت خودکار برای سلامت‌سنجی کانتینر اضافه می‌شوند
DJANGO_ALLOWED_HOSTS=production.example.ir,www.production.example.ir

# مبداهای معتبر CSRF برای درخواست‌های ارسالی با پروتکل HTTPS
DJANGO_CSRF_TRUSTED_ORIGINS=https://production.example.ir,https://www.production.example.ir

# ارسال کوکی‌های نشست و CSRF فقط از طریق ارتباط امن HTTPS (در استقرار HTTPS برابر 1 باشد)
DJANGO_COOKIE_SECURE=1

# در صورت استقرار پشت پروکسی معکوس مورد اعتماد (Nginx یا Nginx Proxy Manager) برابر 1 بگذارید
# این تنظیم باعث خواندن صحیح پروتکل HTTPS از هدر X-Forwarded-Proto می‌شود
DJANGO_TRUST_PROXY=1

# هدایت خودکار ترافیک HTTP به HTTPS در سطح جنگو
# نکته مهم: اگر هدایت در سطح Nginx یا Nginx Proxy Manager انجام می‌شود، این مقدار را 0 بگذارید تا از ایجاد حلقه هدایت جلوگیری شود
DJANGO_SSL_REDIRECT=0

# تنظیم HSTS (HTTP Strict Transport Security) به ثانیه
# راهنمای فعال‌سازی مرحله‌ای: پس از اطمینان از عملکرد صحیح HTTPS، ابتدا 3600 (۱ ساعت)، سپس 86400 (۱ روز)، و نهایتاً 31536000 (۱ سال) تنظیم فرمایید
DJANGO_HSTS_SECONDS=0

# ------------------------------------------------------------------------------
# تنظیمات پایگاه داده PostgreSQL (در محیط عملیاتی اجباری است و fallback وجود ندارد)
# ------------------------------------------------------------------------------
POSTGRES_DB=tileproduction
POSTGRES_USER=tileapp
POSTGRES_PASSWORD=your_strong_and_unique_db_password_here
POSTGRES_HOST=db
POSTGRES_PORT=5432

# ------------------------------------------------------------------------------
# مسیر ذخیره‌سازی رسانه و محدودیت‌های ورود فایل
# ------------------------------------------------------------------------------
# مسیر ریشه فایل‌های رسانه داخل کانتینر (متصل به volume ماندگار)
DJANGO_MEDIA_ROOT=/app/media

# سقف حجم مجاز بارگذاری فایل اکسل (به بایت - پیش‌فرض ۱۰ مگابایت: 10485760)
DJANGO_MAX_UPLOAD_SIZE=10485760

# سقف مجاز تعداد ردیف‌های فایل اکسل جهت جلوگیری از مصرف بی‌رویه حافظه (پیش‌فرض ۲۰۰۰ ردیف)
DJANGO_MAX_IMPORT_ROWS=2000
